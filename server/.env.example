#Sign up for a free API key at https://trefle.io/
TREFLE_API_TOKEN=your_trefle_api_token

#Express Server port (default: 3003)
PORT=3003

#Local (Or cloud) MySQL database instance
#Example: "mysql://root:root@localhost:3306/ithilien"
DATABASE_URL=

#BetterAuth
AUTH_SECRET=my-super-secret-key-change-this-later #Change this later
BETTER_AUTH_URL=http://localhost:3003/ #Same port as PORT

#Whatever URL the client is coming from - used for CORS
CLIENT_URL=http://localhost:5173

#Image Storage (Azure Blob or Local Disk)
IMAGE_ADAPTER="local" #"cloud" || "local" <<< DEFAULTS TO LOCAL IF NOT SET
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME="plant-images" # This is the bucket name in prod
LOCAL_DEV_STORAGE_PATH="dev_img_uploads" #Local folder where we can keep images - Actual img bin will be gitignored.